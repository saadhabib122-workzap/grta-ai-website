# Copy to .env.local and fill in. Everything is optional: without keys the
# site runs fully, the Lab uses its built-in engine, and leads go to the
# Google Sheet only.

# Public URL (used for metadata and social images)
NEXT_PUBLIC_SITE_URL=https://grta.ai

# Claude API: richer Lab results (Claude Sonnet 5.5)
ANTHROPIC_API_KEY=
# Max AI calls per day across the whole site (protects the budget)
LAB_DAILY_AI_CAP=500

# Supabase (server only: never expose the service role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheet (Apps Script) that already receives leads. Defaults to the current one.
LEAD_SHEET_URL=

# Salt for hashing IPs in the rate limiter
RATE_LIMIT_SALT=change-me
