# Copy to .env.local and fill in. Everything is optional: without keys the
# site runs fully and contact requests and news sign-ups go to the Google Sheet.

# Public URL (used for metadata and social images)
NEXT_PUBLIC_SITE_URL=https://grta.ai

# Google Sheet (Apps Script) that receives contact requests and news sign-ups.
# Defaults to the current one; point it at a sheet in GRTA's own Google account.
LEAD_SHEET_URL=

# Salt for hashing IPs in the rate limiter
RATE_LIMIT_SALT=change-me
