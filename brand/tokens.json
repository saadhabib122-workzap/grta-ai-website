{
  "$description": "GRTA brand tokens. Single source of truth for colour, type, radius, spacing and motion. Compiled to brand/tokens.css by brand/src/build_tokens.js.",
  "color": {
    "birch": "#F6F1E8",
    "snow": "#FFFDF9",
    "ink": "#15201B",
    "forest": "#1F3D33",
    "moss": "#6F8C6A",
    "ember": "#E8551E",
    "fjord": "#9DBCCB",
    "clay": "#D8B79B",
    "stone": "#5E5E57",
    "line": "#E4DCCD"
  },
  "theme": {
    "light": {
      "bg": "{color.birch}",
      "surface": "{color.snow}",
      "surface-sunk": "#EFE8DB",
      "text": "{color.ink}",
      "text-muted": "{color.stone}",
      "brand": "{color.forest}",
      "brand-text": "{color.snow}",
      "accent": "{color.ember}",
      "accent-text": "#C2410C",
      "thread": "#5E889C",
      "tag": "#55704F",
      "border": "{color.line}",
      "focus": "{color.ember}"
    },
    "dark": {
      "bg": "#101814",
      "surface": "#18231E",
      "surface-sunk": "#0C120F",
      "text": "#EFE9DE",
      "text-muted": "#A9ADA3",
      "brand": "#A8C7A0",
      "brand-text": "#101814",
      "accent": "#F07A45",
      "accent-text": "#F5966A",
      "thread": "{color.fjord}",
      "tag": "#A8C7A0",
      "border": "#2A3832",
      "focus": "#F07A45"
    }
  },
  "font": {
    "display": "'Schibsted Grotesk', ui-sans-serif, system-ui, sans-serif",
    "body": "'Inter', ui-sans-serif, system-ui, sans-serif",
    "mono": "'Geist Mono', ui-monospace, monospace"
  },
  "type": {
    "display": {
      "size": "clamp(2.75rem, 1.6rem + 4.6vw, 5.5rem)",
      "line": "1.0",
      "weight": 800,
      "tracking": "-0.03em"
    },
    "h1": {
      "size": "clamp(2.25rem, 1.5rem + 3vw, 4rem)",
      "line": "1.05",
      "weight": 700,
      "tracking": "-0.025em"
    },
    "h2": {
      "size": "clamp(1.75rem, 1.3rem + 1.8vw, 2.75rem)",
      "line": "1.1",
      "weight": 700,
      "tracking": "-0.02em"
    },
    "h3": {
      "size": "clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem)",
      "line": "1.25",
      "weight": 650,
      "tracking": "-0.01em"
    },
    "lead": {
      "size": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3rem)",
      "line": "1.55",
      "weight": 400,
      "tracking": "0"
    },
    "body": {
      "size": "1rem",
      "line": "1.6",
      "weight": 400,
      "tracking": "0"
    },
    "small": {
      "size": "0.875rem",
      "line": "1.5",
      "weight": 400,
      "tracking": "0"
    },
    "label": {
      "size": "0.75rem",
      "line": "1.4",
      "weight": 500,
      "tracking": "0.12em"
    }
  },
  "radius": {
    "sm": "6px",
    "md": "12px",
    "lg": "20px",
    "xl": "32px",
    "pill": "999px"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px",
    "9": "96px",
    "10": "128px"
  },
  "shadow": {
    "soft": "0 1px 2px rgba(21,32,27,.04), 0 8px 24px -12px rgba(21,32,27,.12)",
    "lift": "0 2px 4px rgba(21,32,27,.05), 0 24px 48px -20px rgba(21,32,27,.22)",
    "glow": "0 0 0 1px rgba(157,188,203,.35), 0 0 24px rgba(157,188,203,.35)"
  },
  "motion": {
    "ease": "cubic-bezier(.2,.7,.2,1)",
    "ease-in-out": "cubic-bezier(.6,0,.2,1)",
    "fast": "160ms",
    "base": "280ms",
    "slow": "600ms"
  },
  "layout": {
    "max": "1600px",
    "gutter": "clamp(20px, 4vw, 64px)",
    "frame": "clamp(12px, 1.4vw, 24px)"
  }
}
